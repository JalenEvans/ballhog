<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Multi-target the current LTS (.NET 8) and the newest installed SDK (.NET 10). -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>

    <!-- NuGet package metadata. License/README/attribution are added in a later chunk. -->
    <PackageId>ballhog</PackageId>
    <Version>0.1.0-alpha.1</Version>
    <Description>Typed async .NET client for NBA statistics.</Description>
    <Authors>Jalen Evans</Authors>
    <PackageTags>nba;basketball;statistics;sdk;nuget</PackageTags>

    <!-- Packaging is an explicit step; never pack on every build. -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>

    <!-- Validate package compatibility across target frameworks at pack time. -->
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

</Project>
